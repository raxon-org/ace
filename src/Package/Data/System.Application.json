{
  "System":{
    "Application":[
      {
        "name": "Ace",
        "display": {
          "name": "Ace Editor"
        },
        "package": "raxon/{{$this.name|>string.lowercase}}",
        "route": {
          "name": "application-ace-editor"
        },
        "frontend": "{{Package.Raxon.Ace:Setup:install.frontend.get(options())}}",
        "backend": "{{Package.Raxon.Ace:Setup:install.backend.get(options())}}",
        "directory": {
          "application": "Application/{{$this.#parentNode.#parentNode.name}}/"
        },
        "source": {
          "node": {
            "extension" : "{{config('project.dir.node')}}Data/System.Server.Extension.json",
            "content_type": "{{config('project.dir.node')}}Data/System.Server.ContentType.json"
          },
          "extension": "{{config('controller.dir.data')}}System.Server.Extension.json",
          "content_type": "{{config('controller.dir.data')}}System.Server.ContentType.json"
        },
        "method": null,
        "target": null,
        "description": "Ace editor (Editor, Multiple languages)",
        "icon": "Application/{{$this.name}}/Icon/Icon.png",
        "user": "{{Package.Raxon.Ace:Setup:user.list(flags(), options(), $this)}}",
        "extension": "{{Package.Raxon.Ace:Setup:extension.list(flags(), options(), $this)}}"
      }
    ]
  }
}